#usda 1.0
(
    defaultPrim = "MugTree"
    metersPerUnit = 1
    kilogramsPerUnit = 1
    upAxis = "Z"
)

def Xform "MugTree" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    )
{
    bool physics:rigidBodyEnabled = true
    float physics:mass = 0.31
    point3f physics:centerOfMass = (0, 0, 0.105)
    custom string asset:description = "MyLifeUNIT-style mug tree with top pair of branches removed"
    custom double asset:overallHeightMeters = 0.35052
    custom double asset:baseDiameterMeters = 0.16002
    custom string asset:units = "meters"

    def Scope "Looks"
    {
        def Material "WoodLong"
        {
            token outputs:surface.connect = </MugTree/Looks/WoodLong/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </MugTree/Looks/WoodLong/BaseColor.outputs:rgb>
                float inputs:metallic = 0
                float inputs:roughness.connect = </MugTree/Looks/WoodLong/Roughness.outputs:r>
                normal3f inputs:normal.connect = </MugTree/Looks/WoodLong/Normal.outputs:rgb>
                float inputs:ior = 1.5
                token outputs:surface
            }

            def Shader "PrimvarReader"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                string inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "BaseColor"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @textures/black_painted_wood_long_basecolor.png@
                token inputs:sourceColorSpace = "sRGB"
                float2 inputs:st.connect = </MugTree/Looks/WoodLong/PrimvarReader.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float3 outputs:rgb
            }

            def Shader "Roughness"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @textures/black_painted_wood_long_roughness.png@
                token inputs:sourceColorSpace = "raw"
                float2 inputs:st.connect = </MugTree/Looks/WoodLong/PrimvarReader.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float outputs:r
            }

            def Shader "Normal"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @textures/black_painted_wood_long_normal.png@
                token inputs:sourceColorSpace = "raw"
                float4 inputs:scale = (2, 2, 2, 1)
                float4 inputs:bias = (-1, -1, -1, 0)
                float2 inputs:st.connect = </MugTree/Looks/WoodLong/PrimvarReader.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float3 outputs:rgb
            }
        }
        def Material "WoodBase"
        {
            token outputs:surface.connect = </MugTree/Looks/WoodBase/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </MugTree/Looks/WoodBase/BaseColor.outputs:rgb>
                float inputs:metallic = 0
                float inputs:roughness.connect = </MugTree/Looks/WoodBase/Roughness.outputs:r>
                normal3f inputs:normal.connect = </MugTree/Looks/WoodBase/Normal.outputs:rgb>
                float inputs:ior = 1.5
                token outputs:surface
            }

            def Shader "PrimvarReader"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                string inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "BaseColor"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @textures/black_painted_wood_base_basecolor.png@
                token inputs:sourceColorSpace = "sRGB"
                float2 inputs:st.connect = </MugTree/Looks/WoodBase/PrimvarReader.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float3 outputs:rgb
            }

            def Shader "Roughness"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @textures/black_painted_wood_base_roughness.png@
                token inputs:sourceColorSpace = "raw"
                float2 inputs:st.connect = </MugTree/Looks/WoodBase/PrimvarReader.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float outputs:r
            }

            def Shader "Normal"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @textures/black_painted_wood_base_normal.png@
                token inputs:sourceColorSpace = "raw"
                float4 inputs:scale = (2, 2, 2, 1)
                float4 inputs:bias = (-1, -1, -1, 0)
                float2 inputs:st.connect = </MugTree/Looks/WoodBase/PrimvarReader.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float3 outputs:rgb
            }
        }
        def Material "Rubber"
        {
            token outputs:surface.connect = </MugTree/Looks/Rubber/PreviewSurface.outputs:surface>
            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.01, 0.011, 0.013)
                float inputs:metallic = 0.0
                float inputs:roughness = 0.82
                float inputs:ior = 1.5
                token outputs:surface
            }
        }
        def Material "SocketMetal"
        {
            token outputs:surface.connect = </MugTree/Looks/SocketMetal/PreviewSurface.outputs:surface>
            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.025, 0.027, 0.031)
                float inputs:metallic = 0.72
                float inputs:roughness = 0.32
                float inputs:ior = 1.5
                token outputs:surface
            }
        }
        def Material "SocketRecess"
        {
            token outputs:surface.connect = </MugTree/Looks/SocketRecess/PreviewSurface.outputs:surface>
            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.0015, 0.0015, 0.002)
                float inputs:metallic = 0.0
                float inputs:roughness = 0.6
                float inputs:ior = 1.5
                token outputs:surface
            }
        }
        def Material "PhysicsMaterial" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:staticFriction = 0.56
            float physics:dynamicFriction = 0.46
            float physics:restitution = 0.03
        }
    }

