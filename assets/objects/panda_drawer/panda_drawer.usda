                float3 xformOp:scale = (0.305, 0.01, 0.056)
                double3 xformOp:translate = (0, 0.15857000648975372, 0.12509000301361084)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
            }

            def Cube "front_lip_collision" (
                prepend apiSchemas = ["PhysicsCollisionAPI"]
            )
            {
                double size = 1
                token visibility = "invisible"
                float3 xformOp:scale = (0.305, 0.01, 0.056)
                double3 xformOp:translate = (0, 0.0035699999425560236, 0.12509000301361084)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
            }
        }

        def PhysicsFixedJoint "upper_drawer_handle_joint"
        {
            rel physics:body0 = </PandaDrawer/upper_drawer>
            rel physics:body1 = </PandaDrawer/upper_drawer_handle>
            point3f physics:localPos0 = (0, -0.017, 0.12)
            point3f physics:localPos1 = (0, 0, 0)
        }
    }

    def Xform "upper_drawer_handle" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "PhysxRigidBodyAPI"]
    )
    {
        float physics:mass = 0.05
        bool physxRigidBody:enableGyroscopicForces = 1
        int physxRigidBody:solverPositionIterationCount = 16
        int physxRigidBody:solverVelocityIterationCount = 4
        double3 xformOp:translate = (0, -0.017000000923871994, 0.11999999731779099)
        uniform token[] xformOpOrder = ["xformOp:translate"]

        def Scope "collisions"
        {
            def Cylinder "handle_grip_collision" (
                prepend apiSchemas = ["PhysicsCollisionAPI"]
            )
            {
                uniform token axis = "X"
                double height = 0.1582
                double radius = 0.0085
                token visibility = "invisible"
                double3 xformOp:translate = (0, -0.007000000216066837, 0)
                uniform token[] xformOpOrder = ["xformOp:translate"]
            }

            def Cube "handle_mount_collision" (
                prepend apiSchemas = ["PhysicsCollisionAPI"]
            )
            {
                double size = 1
                token visibility = "invisible"
                float3 xformOp:scale = (0.1582, 0.0225, 0.017)
                double3 xformOp:translate = (0, 0.0042500002309679985, 0)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
            }
        }
    }

    def PhysicsFixedJoint "root_joint" (
        prepend apiSchemas = ["PhysicsArticulationRootAPI", "PhysxArticulationAPI"]
    )
    {
        rel physics:body0 = None
        rel physics:body1 = </PandaDrawer/base>
    }

    def Scope "Cameras"
    {
        def Camera "front_minus_y"
        {
            float2 clippingRange = (0.01, 5)
            float focalLength = 45
            float horizontalAperture = 24
            float verticalAperture = 16
            matrix4d xformOp:transform = ( (1, 0, -0, 0), (0, 0.015997952393132148, 0.9998720245707583, 0), (0, -0.9998720245707583, 0.015997952393132148, 0), (0, -0.55, 0.13, 1) )
            uniform token[] xformOpOrder = ["xformOp:transform"]
