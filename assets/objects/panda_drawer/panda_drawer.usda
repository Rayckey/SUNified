            float verticalAperture = 16
            matrix4d xformOp:transform = ( (0.7767557487195038, 0.6298019584212194, 2.7755575615628926e-17, 0), (-0.1697639531197483, 0.20937554218102283, 0.9629860240717718, -0), (0.6064904838926651, -0.748004930134287, 0.26955132617451794, 0), (0.45, -0.48, 0.32, 1) )
