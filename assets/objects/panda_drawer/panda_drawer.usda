            matrix4d xformOp:transform = ( (0, 1, -0, 0), (-0.03633961810714302, 0, 0.9993394979464322, -0), (0.9993394979464322, -0, 0.03633961810714302, 0), (0.55, 0.075, 0.14, 1) )
            uniform token[] xformOpOrder = ["xformOp:transform"]
        }

