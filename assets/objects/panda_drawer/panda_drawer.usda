                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
            }
        }

        def PhysicsPrismaticJoint "upper_drawer_joint" (
            prepend apiSchemas = ["PhysicsDriveAPI:linear", "PhysxJointAPI"]
        )
        {
            float drive:linear:physics:damping = 0
            float drive:linear:physics:maxForce = 0.1
            float drive:linear:physics:stiffness = 0
            float drive:linear:physics:targetVelocity = 0
            uniform token drive:linear:physics:type = "force"
            uniform token physics:axis = "Y"
            rel physics:body0 = </PandaDrawer/frame>
            rel physics:body1 = </PandaDrawer/upper_drawer>
            quatf physics:localRot0 = (0, 1, 0, 0)
            quatf physics:localRot1 = (0, 1, 0, 0)
            float physics:lowerLimit = 0
            float physics:upperLimit = 0.15
            float physxJoint:maxJointVelocity = 10
        }
    }

    def Xform "upper_drawer" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "PhysxRigidBodyAPI"]
    )
    {
        float physics:mass = 0.6
        bool physxRigidBody:enableGyroscopicForces = 1
        int physxRigidBody:solverPositionIterationCount = 16
        int physxRigidBody:solverVelocityIterationCount = 4

        def Scope "visuals"
        {
            def Xform "drawer_visual"
            {
                double3 xformOp:translate = (0, 0.08100000023841858, 0.11999999731779099)
                uniform token[] xformOpOrder = ["xformOp:translate"]

                def Xform "source" (
                    prepend references = @panda_drawer_drawer/panda_drawer_drawer.usdc@
                )
                {
                    float3 xformOp:rotateXYZ = (0, 0, 180)
                    uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]
                }
            }
        }

        def Scope "collisions"
        {
            def Cube "floor_collision" (
