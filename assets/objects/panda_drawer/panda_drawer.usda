        int physxRigidBody:solverPositionIterationCount = 16
        int physxRigidBody:solverVelocityIterationCount = 4

        def Scope "visuals"
        {
            def Xform "body_visual"
            {
                def Xform "source" (
                    prepend references = @panda_drawer_body/panda_drawer_body.usdc@
                )
                {
                }
            }
        }

        def Scope "collisions"
        {
            def Cube "left_side_rail_collision" (
                prepend apiSchemas = ["PhysicsCollisionAPI"]
            )
            {
                double size = 1
