                double3 xformOp:translate = (-0.1589999943971634, 0.08382599800825119, 0.11132500320672989)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
            }

            def Cube "right_side_rail_collision" (
