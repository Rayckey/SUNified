#usda 1.0
(
    defaultPrim = "PandaDrawer"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "PandaDrawer"
{
    def Xform "base" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "PhysxRigidBodyAPI"]
    )
    {
        float physics:mass = 0.01
        bool physxRigidBody:enableGyroscopicForces = 1
        int physxRigidBody:solverPositionIterationCount = 16
        int physxRigidBody:solverVelocityIterationCount = 4

        def PhysicsFixedJoint "base_to_frame"
        {
            rel physics:body0 = </PandaDrawer/base>
            rel physics:body1 = </PandaDrawer/frame>
            point3f physics:localPos0 = (0, 0, 0)
            point3f physics:localPos1 = (0, 0, 0)
        }
    }

    def Xform "frame" (
