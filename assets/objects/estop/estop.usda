#usda 1.0
(
    defaultPrim = "EStop"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "EStop" (
    prepend apiSchemas = ["PhysicsArticulationRootAPI", "PhysxArticulationAPI"]
)
{
    def Xform "base_link" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "PhysxRigidBodyAPI"]
        prepend references = @../stop_base/base.usdc@
    )
    {
        float physics:mass = 0.35
        bool physxRigidBody:enableGyroscopicForces = 1
        int physxRigidBody:solverPositionIterationCount = 16
        int physxRigidBody:solverVelocityIterationCount = 4

        def Cube "base_collision" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
            double size = 1
            token visibility = "invisible"
            float3 xformOp:scale = (0.078, 0.072, 0.073)
            double3 xformOp:translate = (0, 0, 0.0364999994635582)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
    }

    def Xform "carrier_link" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "PhysxRigidBodyAPI"]
    )
    {
        float physics:mass = 0.02
        bool physxRigidBody:enableGyroscopicForces = 1
        int physxRigidBody:solverPositionIterationCount = 16
        int physxRigidBody:solverVelocityIterationCount = 4

        def Cube "carrier_visual" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
            color3f[] primvars:displayColor = [(0.15, 0.15, 0.15)]
            double size = 1
            token visibility = "invisible"
            float3 xformOp:scale = (0.016, 0.016, 0.02)
            uniform token[] xformOpOrder = ["xformOp:scale"]
        }
    }

    def Xform "cap_link" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "PhysxRigidBodyAPI"]
        prepend references = @../stop_cap/cap.usdc@
    )
    {
        float physics:mass = 0.08
        bool physxRigidBody:enableGyroscopicForces = 1
        int physxRigidBody:solverPositionIterationCount = 16
        int physxRigidBody:solverVelocityIterationCount = 4

        def Cylinder "cap_collision" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
        )
        {
            uniform token axis = "Z"
            double height = 0.04
            rel material:binding:physics = </EStop/Looks/CapPhysicsMaterial> (
                bindMaterialAs = "weakerThanDescendants"
            )
            double radius = 0.02
            token visibility = "invisible"
            double3 xformOp:translate = (0, 0, 0.019999999552965164)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
    }

    def Scope "Looks"
    {
        def Material "CapPhysicsMaterial" (
            prepend apiSchemas = ["PhysicsMaterialAPI", "PhysxMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 2.5
            float physics:restitution = 0
            float physics:staticFriction = 2.5
            uniform token physxMaterial:frictionCombineMode = "max"
            uniform token physxMaterial:restitutionCombineMode = "min"
        }
    }

    def Scope "Joints"
    {
        def PhysicsPrismaticJoint "estop_press_joint" (
            prepend apiSchemas = ["PhysicsDriveAPI:linear", "PhysxJointAPI"]
        )
        {
            float drive:linear:physics:damping = 80
            float drive:linear:physics:maxForce = 200
            float drive:linear:physics:stiffness = 800
            float drive:linear:physics:targetPosition = 0
            float drive:linear:physics:targetVelocity = 0
            uniform token drive:linear:physics:type = "force"
            uniform token physics:axis = "Z"
            rel physics:body0 = </EStop/base_link>
            rel physics:body1 = </EStop/carrier_link>
            point3f physics:localPos0 = (0, 0, 0.068)
            point3f physics:localPos1 = (0, 0, 0)
            float physics:lowerLimit = -0.01
            float physics:upperLimit = 0
            float physxJoint:maxJointVelocity = 0.5
        }

        def PhysicsRevoluteJoint "estop_twist_joint" (
            prepend apiSchemas = ["PhysicsDriveAPI:angular", "PhysxJointAPI"]
        )
        {
            float drive:angular:physics:damping = 0.8
            float drive:angular:physics:maxForce = 1
            float drive:angular:physics:stiffness = 0.5
            float drive:angular:physics:targetPosition = 0
            float drive:angular:physics:targetVelocity = 0
            uniform token drive:angular:physics:type = "force"
            uniform token physics:axis = "Z"
            rel physics:body0 = </EStop/carrier_link>
            rel physics:body1 = </EStop/cap_link>
            point3f physics:localPos0 = (0, 0, 0)
            point3f physics:localPos1 = (0, 0, 0)
            float physics:lowerLimit = -100
            float physics:upperLimit = 0
            float physxJoint:maxJointVelocity = 4
        }

        def PhysicsFixedJoint "world_fix"
        {
            rel physics:body0 = None
            rel physics:body1 = </EStop/base_link>
        }
    }
}

